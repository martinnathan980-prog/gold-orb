+   for(int i = 0; i < n; i++)
+     {
+      double a = k[i].ask;
+      if(a <= 0.0) continue;
+      if(o == 0.0) o = a;
+      if(a > h) h = a;
+      if(a < l) l = a;
+     }
+   if(o > 0.0) { ao = o; ah = h; al = l; }
+  }
